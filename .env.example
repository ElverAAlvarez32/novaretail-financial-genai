# ============================================================
# NovaRetail Financial GenAI
# Plantilla de variables de entorno
# ============================================================
#
# IMPORTANTE:
# Este archivo contiene solamente nombres y valores de ejemplo.
# No almacena claves, contraseñas ni información confidencial.
#
# Cuando sea necesario, se creará un archivo local llamado .env.
# El archivo .env está excluido mediante .gitignore.
# ============================================================


# ------------------------------------------------------------
# ENTORNO DE EJECUCIÓN
# ------------------------------------------------------------

# Valores permitidos previstos:
# development, testing, production
APP_ENV=development

# Valores habituales:
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ------------------------------------------------------------
# CONFIGURACIÓN GENERAL DEL PROYECTO
# ------------------------------------------------------------

PROJECT_NAME=NovaRetail Financial GenAI
PROJECT_VERSION=0.1.0

# Semilla fija para reproducir los datos sintéticos.
RANDOM_SEED=20261104

# Zona horaria de referencia.
APP_TIMEZONE=America/Bogota


# ------------------------------------------------------------
# RUTAS DEL PROYECTO
# ------------------------------------------------------------

RAW_DATA_DIR=data/raw
CLEAN_DATA_DIR=data/clean
REFERENCE_DATA_DIR=data/reference

OUTPUT_CHARTS_DIR=outputs/charts
OUTPUT_REPORTS_DIR=outputs/reports
OUTPUT_LOGS_DIR=outputs/logs
OUTPUT_EVIDENCE_DIR=outputs/evidence
OUTPUT_AUDIT_DIR=outputs/audit


# ------------------------------------------------------------
# INTELIGENCIA ARTIFICIAL GENERATIVA
# ------------------------------------------------------------
#
# Estos campos permanecerán vacíos hasta seleccionar y autorizar
# un proveedor y un modelo de IA generativa.
#
# No escribas aquí una clave real.
# La clave real se almacenaría solamente en el archivo local .env.
# ------------------------------------------------------------

GENAI_ENABLED=false
GENAI_PROVIDER=
GENAI_MODEL=
GENAI_API_KEY=
GENAI_ENDPOINT=
GENAI_API_VERSION=


# ------------------------------------------------------------
# CONTROLES DE IA
# ------------------------------------------------------------

# Revisión humana obligatoria antes de aprobar una salida.
HUMAN_REVIEW_REQUIRED=true

# Registro de prompts, respuestas y evaluaciones.
AI_AUDIT_LOG_ENABLED=true

# Impedir el uso de entradas clasificadas como sensibles.
BLOCK_SENSITIVE_DATA=true


# ------------------------------------------------------------
# CONFIGURACIÓN DE LA APLICACIÓN
# ------------------------------------------------------------

STREAMLIT_SERVER_PORT=8501

# Desactiva el envío de estadísticas de uso de Streamlit.
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false


# ------------------------------------------------------------
# EXPORTACIÓN
# ------------------------------------------------------------

DEFAULT_REPORT_LANGUAGE=es
DEFAULT_CURRENCY=COP
DEFAULT_REPORTING_UNIT=thousands